# Coolify environment variables for single-service deployment
# Copy this file to coolify.env and replace placeholder values before deploying.

# Nixpacks runtime settings (Docker deployment is recommended)
NIXPACKS_NODE_VERSION=22
NIXPACKS_INSTALL_CMD=npm install

# Application ports
FRONTEND_PORT=3002
API_PORT=4002
PORT=3002

# Frontend API base
VITE_API_BASE_URL=/api
VITE_DEFAULT_PHASE=T6

# Backend auth
ADMIN_API_TOKEN=replace-with-a-random-admin-token
SESSION_SECRET=replace-with-a-random-session-secret

# Discord bot
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_GUILD_ID=replace-with-discord-guild-id
DISCORD_WEBHOOK_URL=replace-with-discord-webhook-url

# Battle.net OAuth
BNET_CLIENT_ID=replace-with-battlenet-client-id
BNET_CLIENT_SECRET=replace-with-battlenet-client-secret
BNET_REGION=eu
REDIRECT_URI=https://your-domain.example/api/auth/bnet/callback
SITE_URL=https://your-domain.example/

# Battle.net RBAC + session persistence
BNET_PRIMARY_ADMIN_BATTLETAG=YourBattletag#1234
BNET_SESSION_TTL_HOURS=720

# Persist this path with a Coolify volume mounted at /app/data.
GUILD_LOOT_DB_PATH=/app/data/mydb.db