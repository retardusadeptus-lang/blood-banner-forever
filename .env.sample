# ===== Backend (guild-loot-api/server.js) =====

# Discord webhook for loot/bank notifications. Optional — leave blank to disable.
DISCORD_WEBHOOK_URL=

# Admin password. Verified server-side at POST /api/login; never shipped to the
# browser. Write operations (POST/PUT/DELETE/PATCH) require a valid session.
ADMIN_API_TOKEN=

# Secret used to sign session tokens. Set a long random value in prod so sessions
# survive restarts. If unset, a random one is generated per boot (forces re-login
# after every restart). Generate with: openssl rand -hex 32
SESSION_SECRET=bfKv7s0o8UiqeF4G1l24b5MghkFmJ2aH

# Battle.net battletag that is always treated as primary admin (case-insensitive).
# This account can promote/demote admins; other admins can only manage officers.
BNET_PRIMARY_ADMIN_BATTLETAG="Steve#2506"

# Lifetime in hours for the app's Battle.net login cookie/session.
# Increase to keep users logged in longer (e.g. 720 = 30 days).
BNET_SESSION_TTL_HOURS=720

# Port the API listens on (nginx proxies /api/ to this port).
PORT=4002

# Public site URL used in Discord notification links.
SITE_URL=https://guild-name-tbc.top/

# Override the SQLite database path. Optional — defaults to guild-loot-api/mydb.db.
GUILD_LOOT_DB_PATH=

# ===== Frontend (Vite, baked in at build time, must be prefixed VITE_) =====

# Base URL the frontend uses to reach the API. Relative /api is same-origin and
# is proxied to the backend by nginx (Docker) and the Vite dev server (local).
# Only set an absolute URL (e.g. http://localhost:4555/api) to bypass the proxy.
VITE_API_BASE_URL=/api

# (VITE_ADMIN_API_TOKEN removed — the admin secret is no longer sent to or stored
# in the browser. Auth now goes through POST /api/login.)
