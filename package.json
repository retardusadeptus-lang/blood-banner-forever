{
  "name": "wow-loot-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "test:registry": "node --test src/config/siteRegistry.test.js",
    "test:view-model": "node --test src/hooks/useDashboardMainContentViewModel.test.js",
    "start": "node guild-loot-api/server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "node --env-file=.env guild-loot-api/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "dev:full": "npm run dev:all",
    "start:full": "powershell -ExecutionPolicy Bypass -File ./scripts/start-full.ps1",
    "build:docker": "docker build -t gntbc:latest -f ./Dockerfile .",
    "seed:recruitment": "node guild-loot-api/scripts/seed_recruitment_roster.js",
    "seed:demo": "node guild-loot-api/scripts/seed_demo_data.js",
    "export:cheat-sheet": "node scripts/export-cheat-sheet.mjs",
    "import:cheat-sheet": "node scripts/import-cheat-sheet.mjs"
  },
  "postinstall": "cd guild-loot-api && npm install && cd .. && npm run build:prod",
  "dependencies": {
    "axios": "^1.17.0",
    "luxon": "^3.7.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
